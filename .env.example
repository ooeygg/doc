SANITY_PROJECT_ID=xxxxxxxx
SANITY_DATASET=production
SANITY_API_VERSION=2024-10-01
SANITY_REVALIDATE_SECRET=replace-with-long-random-string

# HubSpot
HUBSPOT_PRIVATE_APP_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=xxxxxxx

# CORS — origin allowed to call /api/hubspot/contact from the browser.
# Set to the landing page domain in production; omit to allow any origin (*).
ALLOWED_ORIGIN=https://welcome.workofangelsllc.com

# Client
# Canonical site and sharing URLs are set in config/site.ts.
# Existing Calendly appointment URL. If unset, /book offers a contact link.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/chiggins1806
NEXT_PUBLIC_XPERIENCIFY_URL=https://cynthiahiggins.xperiencify.io
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=drcynthiahiggins.com

# Local-only escape hatch leave unset in CI/prod
SKIP_ENV_VALIDATION=
